{
  "name": "dsh-plugin-dxpdf",
  "version": "1.3.0",
  "description": "DeepSeek Harness plugin exposing dxpdf_convert: convert a Microsoft Word DOCX file to PDF with the dxpdf Rust/Skia engine — no Microsoft Office, no LibreOffice, no network. It repairs the schema-invalid constructs WPS Office writes, lowers the equations the engine would silently drop, and restores Word's odd/even page parity.",
  "type": "module",
  "license": "MIT",
  "author": "bauerelizabeth07139",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bauerelizabeth07139/dsh-plugin-dxpdf.git"
  },
  "homepage": "https://github.com/bauerelizabeth07139/dsh-plugin-dxpdf#readme",
  "bugs": {
    "url": "https://github.com/bauerelizabeth07139/dsh-plugin-dxpdf/issues"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./convert": {
      "default": "./lib/convert.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "py",
    "assets",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "icon": "./assets/icon.svg",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/convert.test.mjs && node --import ./test/hooks.mjs test/tool.test.mjs && node test/repair.test.mjs && node test/math.test.mjs && node test/security.test.mjs && node test/paginate.test.mjs && node test/bundle.test.mjs",
    "test:core": "node test/convert.test.mjs",
    "test:tool": "node --import ./test/hooks.mjs test/tool.test.mjs",
    "test:repair": "node test/repair.test.mjs",
    "test:math": "node test/math.test.mjs",
    "test:security": "node test/security.test.mjs",
    "test:paginate": "node test/paginate.test.mjs",
    "test:bundle": "node test/bundle.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.1 <0.2.0-0 || >=0.2.0-rc.0 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dxpdf",
    "docx",
    "docx-to-pdf",
    "pdf",
    "word",
    "conversion",
    "office",
    "wps",
    "ooxml"
  ]
}
